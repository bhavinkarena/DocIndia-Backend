PORT=9002
# "production" switches the refresh cookie to Secure + SameSite=None, which is
# required when the frontend and API are on different hosts.
NODE_ENV=development

MONGO_URI=
MONGO_DB=docuindia

JWT_SECRET=

# Access tokens are short because nothing can revoke a JWT; the refresh token
# in the httpOnly cookie is what keeps a user signed in, and it IS revocable.
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_DAYS=7
# How long a password reset link stays valid.
RESET_TOKEN_MINUTES=30

FRONTEND_URL=http://localhost:5173

# trace | debug | info | warn | error | fatal. Worth being able to raise
# without a deploy — the moment you need debug logging is the moment you
# cannot ship a code change to get it.
LOG_LEVEL=info

# How long a soft-deleted record survives before the Sunday cleanup removes it
# permanently. Long enough that a mistaken deletion is always recoverable.
SOFT_DELETE_RETENTION_DAYS=90

# /api-docs is served in development automatically. Set this to expose it in a
# deployed environment — the spec names every endpoint and its role
# requirement, which is a map of the attack surface.
ENABLE_API_DOCS=

# Number of proxy hops in front of the app, so rate limiting sees the real
# client IP instead of the load balancer's. Leave blank when running directly
# — trusting a proxy that isn't there lets clients forge X-Forwarded-For and
# bypass the limits entirely. Set to 1 on Render / Railway / Fly.
TRUST_PROXY=

# Leave EMAIL_USER / EMAIL_PASS blank to run the email service in
# console-log mode (nothing is actually sent). Password reset links are
# printed to the server log in that mode.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=DocuIndia <no-reply@docuindia.local>

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
