  "rules": [
    {
      "serviceSlug": "epfo",
      "action": "new",
      "state": null,
      "summary": "Initial import — work & money pack",
      "baseDocuments": [
        { "slug": "uan-details", "mandatory": true },
        { "slug": "aadhaar-card", "mandatory": true, "note": "Must be the one seeded against your UAN." },
        { "slug": "pan-card", "mandatory": true, "note": "Without it, tax is deducted at a much higher rate on early withdrawals." },
        { "slug": "bank-account-statement", "mandatory": true, "note": "The account must be in your name and linked to the UAN." },
        { "slug": "cancelled-cheque", "mandatory": true, "note": "Showing your name, account number and IFSC." }
      ],
      "conditionalBlocks": [
        {
          "label": "KYC not yet verified",
          "matchType": "all",
          "conditions": [{ "questionKey": "kycVerified", "operator": "eq", "value": false }],
          "documents": [{ "slug": "affidavit", "mandatory": false, "note": "Your employer must approve the KYC on the portal before a claim will go through — chase them first." }]
        },
        {
          "label": "Advance withdrawal",
          "matchType": "all",
          "conditions": [{ "questionKey": "withdrawalType", "operator": "eq", "value": "advance" }],
          "documents": [{ "slug": "affidavit", "mandatory": true, "note": "Evidence of the reason — medical estimate, sale agreement, fee demand or wedding card." }]
        }
      ],
      "processSteps": [
        { "title": "Verify KYC on the UAN portal", "detail": "Aadhaar, PAN and bank details must all show as approved by your employer.", "mode": "online", "url": "https://unifiedportal-mem.epfindia.gov.in/", "order": 1, "minDays": 3, "maxDays": 30, "conditions": [{ "questionKey": "kycVerified", "operator": "eq", "value": false }] },
        { "title": "File the claim online (Form 19 / 31)", "mode": "online", "url": "https://unifiedportal-mem.epfindia.gov.in/", "order": 2, "minDays": 1, "maxDays": 1, "fees": [{ "label": "Claim filing", "amount": 0, "order": 1 }] },
        { "title": "Wait for the claim to settle", "detail": "Paid directly into the linked bank account.", "mode": "online", "order": 3, "minDays": 7, "maxDays": 30 }
      ]
    },
